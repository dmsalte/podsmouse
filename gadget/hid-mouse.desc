# HID report descriptor for the PodsMouse USB gadget (hex, one item per line).
# Comments start with '#'. setup-hid-gadget.sh strips them and writes the bytes
# to functions/hid.usb0/report_desc.
#
# Relative mouse, 3 buttons + wheel, no report ID. Every input report is 4 bytes:
#
#   byte 0  buttons   bit0 = left, bit1 = right, bit2 = middle, bits 3-7 = padding (0)
#   byte 1  X         signed int8, -127..127, relative
#   byte 2  Y         signed int8, -127..127, relative (positive = down)
#   byte 3  wheel     signed int8, -127..127, relative (positive = up)
#
# This must match podsmouse/sinks/hid_gadget.py (HidSink) and report_length = 4.

05 01   # Usage Page (Generic Desktop)
09 02   # Usage (Mouse)
A1 01   # Collection (Application)
09 01   #   Usage (Pointer)
A1 00   #   Collection (Physical)
05 09   #     Usage Page (Button)
19 01   #     Usage Minimum (Button 1)
29 03   #     Usage Maximum (Button 3)
15 00   #     Logical Minimum (0)
25 01   #     Logical Maximum (1)
95 03   #     Report Count (3)
75 01   #     Report Size (1)
81 02   #     Input (Data, Variable, Absolute)      -> 3 button bits
95 01   #     Report Count (1)
75 05   #     Report Size (5)
81 03   #     Input (Constant, Variable, Absolute)  -> 5 padding bits
05 01   #     Usage Page (Generic Desktop)
09 30   #     Usage (X)
09 31   #     Usage (Y)
09 38   #     Usage (Wheel)
15 81   #     Logical Minimum (-127)
25 7F   #     Logical Maximum (127)
75 08   #     Report Size (8)
95 03   #     Report Count (3)
81 06   #     Input (Data, Variable, Relative)      -> X, Y, wheel
C0      #   End Collection
C0      # End Collection
